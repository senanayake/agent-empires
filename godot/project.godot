config_version=5

[application]
config/name="Agent Empires — passive PaymentCo preview"
run/max_fps=60
run/main_scene="res://scenes/organization.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=1000
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)
